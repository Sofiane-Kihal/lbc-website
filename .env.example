# Comma-separated list of admin emails allowed to log in
ADMIN_EMAILS=hello@labandecreative.com

# Shared admin password (use a strong value, change before production)
ADMIN_PASSWORD=change-me-in-production

# Long random string used to sign session cookies (32+ chars)
SESSION_SECRET=replace-this-with-a-random-32-character-string

# --- Forwarder d'emails (formulaires de brief) ---
# Destinataire des soumissions (brief 15 questions + quick contact).
# Fallback : contact@labandecreative.fr si non défini.
CONTACT_EMAIL=contact@labandecreative.fr

# Clé API Resend (https://resend.com → API Keys). Obligatoire pour l'envoi.
# Sans cette clé, les leads sont quand même stockés dans Netlify Blobs.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse expéditrice — DOIT être un domaine vérifié sur Resend.
# Pour vérifier labandecreative.fr : Resend → Domains → Add Domain →
# copier les enregistrements DNS (SPF, DKIM) chez le registrar du domaine.
EMAIL_FROM="La Bande Créative <brief@labandecreative.fr>"
